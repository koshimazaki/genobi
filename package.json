{
  "name": "camera-director",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "check:worker": "tsc -p worker/tsconfig.json --noEmit",
    "stats": "node observability/stats.mjs",
    "dev:cloud": "npm run build && wrangler dev",
    "deploy": "npm run build && npm run check:worker && wrangler deploy",
    "build:pages": "npm run build && npm run check:worker && node scripts/build-pages.mjs",
    "deploy:pages": "npm run build:pages && node scripts/deploy-pages.mjs",
    "format:check": "prettier --check .",
    "camera-test": "tsx scripts/camera-test.ts",
    "build:scene-adapter": "node scripts/build-scene-adapter.mjs",
    "check:scene-adapter": "node scripts/check-scene-adapter.mjs",
    "director:validators": "node scripts/generate-director-validators.mjs",
    "check:director-validators": "node scripts/generate-director-validators.mjs --check",
    "wiki:index": "node scripts/wiki-index.mjs",
    "check:wiki": "node scripts/wiki-index.mjs --check",
    "licences": "node scripts/licence-report.mjs",
    "check:licences": "node scripts/licence-report.mjs --check",
    "check:size": "node scripts/check-file-size.mjs",
    "check:no-reload": "node --import tsx scripts/check-no-reload.mjs",
    "mcp": "tsx mcp/main.ts",
    "build:mcp": "node scripts/build-mcp.mjs",
    "agent:hermes-profile": "tsx scripts/setup-hermes-profile.ts",
    "agent:hermes-roles": "tsx scripts/setup-hermes-roles.ts",
    "registry": "tsx scripts/registry.ts && npm run wiki:index",
    "check:registry": "tsx scripts/registry.ts --check",
    "capabilities": "tsx scripts/check-capabilities.ts --write && npm run wiki:index",
    "check:capabilities": "tsx scripts/check-capabilities.ts",
    "taste:catalog": "node scripts/taste-catalog.mjs",
    "genobi": "tsx cli/main.ts",
    "swap": "tsx scripts/openjutsu-swap.ts",
    "supervisor": "python3 scripts/hermes-supervisor.py",
    "favicon": "node scripts/build-favicon.mjs",
    "check:editor-monitors": "node scripts/check-editor-monitors.mjs"
  },
  "dependencies": {
    "@alienkitty/space.js": "1.2.0",
    "@comfyorg/sdk": "0.5.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@paper-design/shaders": "0.0.81",
    "@pixiv/three-vrm": "3.5.4",
    "ajv": "8.20.0",
    "animejs": "4.5.0",
    "cli-spinners": "3.4.0",
    "express": "^5.1.0",
    "fflate": "0.8.3",
    "mediabunny": "1.61.5",
    "mp4box": "^2.4.1",
    "onnxruntime-web": "1.24.3",
    "p5": "2.3.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.180.0",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.18.0",
    "@types/p5": "^1.7.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^4.7.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "miniflare": "^5.20260918.0-alpha",
    "playwright": "1.60.0",
    "prettier": "^3.9.8",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "genobi": "plugins/genobi/server/genobi-cli.mjs"
  }
}
