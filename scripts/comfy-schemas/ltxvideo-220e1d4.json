        "tile_overlap": [
          "INT",
          { "default": 64, "min": 16, "max": 256, "step": 16 }
        ]
      },
      "optional": {
        "use_streaming": ["BOOLEAN", { "default": false }],
        "tile_frames": [
          "INT",
          { "default": 97, "min": 0, "max": 1000, "step": 1 }
        ]
      }
    },
    "input_order": {
      "required": [
        "positive",
        "negative",
        "vae",
        "latent",
        "image",
        "frame_idx",
        "strength",
        "latent_downscale_factor",
        "crop",
        "use_tiled_encode",
        "tile_size",
        "tile_overlap"
      ],
      "optional": ["use_streaming", "tile_frames"]
