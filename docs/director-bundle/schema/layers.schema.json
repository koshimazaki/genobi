    },
    "clipPrompt": {
      "description": "This clip's own prompt (shared/director/directions.ts): free text the person or an agent wrote for this clip only. Line breaks kept; no other control characters. Optional and additive; absent means none.",
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^[^\\u0000-\\u0009\\u000b-\\u001f\\u007f]*$"
    },
    "directions": {
      "description": "This clip's typed directions (shared/director/directions.ts), stored apart from its prompt so a menu change never rewrites authored text. shot and lens are creative labels, not provider parameters or calibrated optics; camera holds Genobi's camera terms (shared/camera.ts), checked by checkReferences. Optional and additive.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "shot": {
          "enum": [
            "wide",
            "aerial",
            "medium",
            "close-up",
            "insert",
            "low-angle",
            "crane-wide",
            "pass-by",
            "heroic-medium"
          ]
        },
        "lens": {
          "enum": [
            "14mm",
            "18mm",
            "24mm",
            "35mm",
            "50mm",
            "85mm",
            "100mm",
            "135mm",
            "200mm"
          ]
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shot-sizes", "angles", "movements"],
          "properties": {
            "shot-sizes": {
              "type": ["string", "null"],
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "angles": {
              "type": ["string", "null"],
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "movements": {
              "type": ["string", "null"],
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        "action": {
          "enum": [
            "forward",
            "arc",
            "zigzag",
            "rise",
            "accel",
            "decel",
            "converge",
            "hold",
            "drop",
            "impact",
            "infinity",
            "release"
          ]
        }
      }
